# PARK LIVE - EXEMPLE DE CONFIGURACIÓ (.env.example)
# Aquest fitxer conté les claus necessàries per al funcionament de l'aplicació.
# Copia aquest fitxer com a .env i omple els valors amb les teves credencials.

# 1. Configuració de la Base de Dades MySQL (Contenidor 'db')
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=parklive_db
MYSQL_USER=parklive_user
MYSQL_PASSWORD=your_user_password

# 2. Accés a la Base de Dades per al Servei Python
DB_HOST=db
DB_PORT=3306
DB_USER=parklive_user
DB_PASSWORD=your_user_password
DB_NAME=parklive_db

# 3. Configuració SMTP (Enviament d'Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
smtp_mail=your_email@gmail.com
smtp_pasword=your_app_password
RESET_CODE_TTL_MINUTES=30

# 4. Constants de Negoci i Impostos
IVA_PERCENTAGE=0.21
PREMIUM_DISCOUNT=0.10

# 5. Integració amb Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 6. Mapatge de Ports (Docker / Desenvolupament)
PHP_SERVICE_PORT=8080
PYTHON_SERVICE_PORT=5000
FRONTEND_PORT=3000
MYSQL_HOST_PORT=3307
PHPMYADMIN_PORT=8081
FLASK_PORT=5000

# 7. Seguretat i Autenticació JWT
JWT_SECRET=your_secret_key_hex

# 8. Entorn de l'Aplicació
APP_ENV=development
API_HOST=127.0.0.1

# 9. Política CORS (Cross-Origin Resource Sharing)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# 10. Integració amb Stripe (Pagaments i Subscripcions)
STRIPE_APIPublica=pk_test_your_public_key
STRIPE_APIPrivada=sk_test_your_private_key
STRIPE_PREMIUM_PRICE_ID=price_monthly_id
STRIPE_Anual_PREMIUM_PRICE_ID=price_annual_id

# 11. Emmagatzematge de Fitxers i Documents
UPLOAD_DIR=storage/profiles
TICKET_STORAGE_PATH=/app/storage/tickets

# 12. Gestió d'Imatges (Cloudinary)
cloud_name=your_cloud_name
Cloudinary_API_KEY=your_api_key
Cloudinary_API_Secret=your_api_secret
Cloudinary_API_Variable=CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name