# ---------------------------------------------------------
# PARK LIVE - EXEMPLE DE CONFIGURACIÓ (.env)
# ---------------------------------------------------------

# --- CONFIGURACIÓ BASE DE DADES (Docker) ---
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=parklive_db
MYSQL_USER=parklive_user
MYSQL_PASSWORD=user_password_change_me

# --- CONNEXIÓ SERVEIS (Interna Docker) ---
DB_HOST=db
DB_PORT=3306
DB_USER=parklive_user
DB_PASSWORD=user_password_change_me
DB_NAME=parklive_db

# --- PORTS DELS SERVEIS (Exposats al Host) ---
PHP_SERVICE_PORT=8080
PYTHON_SERVICE_PORT=5000
FRONTEND_PORT=3307
MYSQL_HOST_PORT=3306
PHPMYADMIN_PORT=8081
FLASK_PORT=5000

# --- SEGURETAT ---
# Generar una clau segura (ex: openssl rand -hex 32)
JWT_SECRET=canvia_aquesta_clau_per_una_segura

# --- GOOGLE OAUTH 2.0 ---
# Obtingut a Google Cloud Console
GOOGLE_CLIENT_ID=el_teu_client_id.apps.googleusercontent.com

# --- STRIPE (Pagaments i Subscripcions) ---
# Claus obtingudes al Dashboard de Stripe (Test Mode recomanat)
STRIPE_APIPublica=pk_test_...
STRIPE_APIPrivada=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs de productes/preus creats a Stripe
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_Anual_PREMIUM_PRICE_ID=price_...

# --- CONFIGURACIÓ DE NEGOCI ---
IVA_PERCENTAGE=21
PREMIUM_DISCOUNT=10
RESET_CODE_TTL_MINUTES=15

# --- SERVEI DE CORREU (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
smtp_mail=el_teu_correu@gmail.com
smtp_pasword=la_teva_contrasenya_d_aplicacio

# --- ALTRES ---
UPLOAD_DIR=/app/storage/uploads